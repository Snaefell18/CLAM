rules_version = '2';

/* ══════════════════════════════════════════════════════════════════
   CLAM — Firestore-Sicherheitsregeln

   Es geht hier um Gesundheitsdaten nach Art. 9 DSGVO. Die Grundregel:
   Nutzer lesen und schreiben ihre Daten selbst. Eine bestätigte Praxis
   erhält nach Patientenfreigabe begrenzten Lesezugriff.

   Seit der Praxisansicht gibt es einen zweiten Zugriffsweg: eine Praxis
   sieht die Daten der Patienten, die sie über ihren Code freigeschaltet
   haben. Die Verknüpfung steht im Patientendokument — den Zugriff
   erteilt also der Patient und kann ihn jederzeit wieder lösen. Fotos
   bleiben davon ausgenommen.

   Server-Endpunkte schreiben mit dem Admin-SDK und prüfen Authentifizierung
   bzw. einen privaten Import-Schlüssel selbst.

   Firebase Storage wird nicht verwendet: es setzt den Blaze-Plan voraus.
   Auch die Fotos liegen deshalb in Firestore.

   Einspielen:
     firebase deploy --only firestore:rules
   ══════════════════════════════════════════════════════════════════ */

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /* Der Wurzel-Admin steht fest verdrahtet — sonst könnte sich das
       Projekt über die Oberfläche selbst aussperren. Alle weiteren
       Admins stehen in config/admins.

       Diese Prüfung ist die verbindliche. Die gleiche Bedingung im
       Frontend entscheidet nur, ob das Menü zu sehen ist; wer sie im
       Browser aushebelt, kommt hier trotzdem nicht durch. */
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true && (
        request.auth.token.email == 'jan.rentzsch@googlemail.com' ||
        (exists(/databases/$(database)/documents/config/admins) &&
         request.auth.token.email in
           get(/databases/$(database)/documents/config/admins).data.emails)
      );
    }

    /* Der Katalog trägt die Stammdaten der ganzen App: jede angemeldete
       Person muss ihn lesen können, ändern darf ihn nur ein Admin. */
    match /config/catalog {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    match /catalogVersions/{version} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    /* Die Adminliste ist absichtlich NICHT allgemein lesbar — sie enthält
       E-Mail-Adressen. Dass der Leseversuch für Nicht-Admins scheitert,
       ist zugleich die Prüfung, mit der das Frontend den Zugang erkennt. */
    match /config/admins {
      allow read, write: if isAdmin();
    }

    /* ─────────────────  PRAXIS  ─────────────────
       Praxisstammdaten sind Geschäftskontaktdaten, keine Patientendaten.
       Jede angemeldete Person darf sie lesen — sonst könnte ein Patient
       vor dem Verknüpfen nicht sehen, WEN er da freischaltet. Schreiben
       darf nur die Praxis selbst. */
    match /doctors/{uid} {
      allow read:  if request.auth != null;
      allow create: if isOwner(uid) && request.resource.data.verified == false;
      /* Jede selbst vorgenommene Stammdatenänderung entzieht die Freigabe.
         Nur Admins können verified wieder auf true setzen. */
      allow update: if isAdmin() ||
        (isOwner(uid) && request.resource.data.verified == false);
      allow delete: if isAdmin();
    }

    /* Nachschlagetabelle Code → Praxis. Lesbar für Angemeldete, damit ein
       Patient seinen Code auflösen kann. Anlegen darf ihn nur die Praxis
       für sich selbst, und ein einmal vergebener Code lässt sich nicht
       auf eine andere Praxis umbiegen. */
    match /codes/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.doctorUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.doctorUid == request.auth.uid;
    }

    /* Ist diese Person die Praxis, die der Patient freigeschaltet hat?
       Die Verknüpfung steht im Patientendokument — den Zugriff erteilt
       also der Patient, nicht die Praxis. Löst er sie, endet der Zugriff
       mit dem nächsten Lesevorgang. */
    function linkedDoctor(uid) {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/doctors/$(request.auth.uid))
        && get(/databases/$(database)/documents/doctors/$(request.auth.uid)).data.verified == true
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.shareDoctorUid
             == request.auth.uid;
    }

    match /users/{uid} {
      /* Die zweite Bedingung trägt zugleich die Abfrage der Praxis
         (where shareDoctorUid == eigene uid): Firestore prüft die Regel gegen
         jedes Ergebnis, und die Einschränkung stellt sicher, dass nur
         verknüpfte Patienten zurückkommen. */
      allow read: if isOwner(uid)
                  || (request.auth != null && request.auth.token.email_verified == true
                      && resource.data.shareDoctorUid == request.auth.uid
                      && exists(/databases/$(database)/documents/doctors/$(request.auth.uid))
                      && get(/databases/$(database)/documents/doctors/$(request.auth.uid)).data.verified == true);
      allow write: if isOwner(uid);

      match /days/{dayKey} {
        /* Die Praxis liest den Verlauf, schreibt aber nie hinein. Was in
           der App steht, bleibt die Darstellung des Patienten. */
        allow read:  if isOwner(uid) || linkedDoctor(uid);
        allow write: if isOwner(uid);
      }

      match /private/{privateId} {
        allow read, write: if isOwner(uid);
      }

      match /photos/{photoId} {
        /* Die Fotos liegen als Base64 hier statt in Firebase Storage:
           Storage verlangt den Blaze-Plan, Firestore genügt für diesen
           Zweck. Ein Bild je Dokument, damit das Tagesdokument klein
           bleibt und beim Start schnell lädt.

           Bewusst NICHT für die Praxis freigegeben: Bilder von Händen
           sind biometrienah und lassen sich nicht anonymisieren. Die
           Praxis sieht den Befundtext aus dem Tagesdokument, nicht das
           Bild. Wer die Aufnahme selbst zeigen will, tut das im
           Sprechzimmer. */
        allow read, write: if isOwner(uid);
      }

      match /reports/{reportId} {
        /* Berichte sind ein Protokoll dessen, was an die Praxis ging.
           Sie dürfen angelegt und gelesen, aber nicht nachträglich
           verändert werden — ein rückwirkend umgeschriebener Bericht
           wäre wertlos. Löschen bleibt erlaubt, sonst ließe sich das
           Konto nicht vollständig löschen (Art. 17 DSGVO). */
        allow read, create, delete: if isOwner(uid);
        allow update: if false;
      }
    }

    match /ingestTokens/{hash} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    /* Alles, was hier nicht ausdrücklich erlaubt ist, ist verboten. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
