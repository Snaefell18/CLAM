rules_version = '2';

/* ══════════════════════════════════════════════════════════════════
   CLAM — Firebase Storage Regeln

   Hier liegen die Fotos betroffener Körperstellen. Das sind besonders
   sensible Daten: Bilder von Händen sind biometrienah und lassen sich
   nicht anonymisieren.

   Deshalb gilt dasselbe wie in Firestore — nur die eigene Person, und
   zusätzlich eine Größen- und Typprüfung, damit über den Bilderordner
   nichts anderes hochgeladen werden kann.

   Einspielen:
     firebase deploy --only storage
   ══════════════════════════════════════════════════════════════════ */

service firebase.storage {
  match /b/{bucket}/o {

    match /users/{uid}/photos/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   // App verkleinert auf 1280 px — 5 MB sind reichlich Puffer
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
